ENVIRONMENT=development
PORT=8000

APP_NAME=LearnAI
APP_VERSION=1.0.0
DEBUG=true

DB_URL=postgresql://postgres:postgres@localhost:5432/learnai

JWT_SECRET=
JWT_ISSUER=learnai
JWT_TTL_SECONDS=1800

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_TIMEOUT=10

FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000

LOG_LEVEL=info
LOG_FORMAT=console
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=learnai

REDIS_URL=redis://localhost:6379/0
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=
ADMIN_EMAIL=
ADMIN_PASS=
ADMIN_NAME=

RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TEST_BYPASS_SECRET=

CACHE_TTL=3600

CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=true
CORS_METHODS=*
CORS_HEADERS=*

MAX_UPLOAD_SIZE=10485760
STORAGE_MAX_UPLOAD_BYTES=10485760
ALLOWED_EXTENSIONS=.txt,.jpg,.jpeg,.png,.pdf


GEMINI_API_KEY=
COHERE_API_KEY=

GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3.7-flash
EMBEDDING_MODEL=gemini-embedding-001

SRS_DECK_SIZE=20

QUIZ_DEFAULT_QUESTIONS=10

MINDMAP_DEFAULT_NODES=8

XP_SRS_REVIEW=10
XP_QUIZ_CORRECT=5
XP_QUIZ_FINISHED=20
XP_MINDMAP_GENERATED=25
XP_CHAT_MESSAGE=2
XP_CHAT_DAILY_CAP=50
XP_MATERIAL_VIEWED=1
STREAK_GRACE_HOURS=36
XP_HISTORY_PAGE_SIZE=50

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_UPLOADS=learnai
MINIO_BUCKET_AVATARS=learnai
WORKER_INPROCESS=true
UPLOAD_WORKER_CONCURRENCY=4
SEAWEEDFS_JWT_SIGNING_KEY=

