# ---------------------------------------------------------------------------
# LearnAI — repository ignore rules
#
# Layout: a monorepo with two deployable services plus a few support dirs.
#
#   backend/   Express + Socket.IO API (Node 20)
#   frontend/  Next.js 16 app (React 19, TypeScript)
#   chroma/    ChromaDB healthcheck wrapper (mounted into the container)
#   seaweedfs/ SeaweedFS healthcheck wrapper (mounted into the container)
#   docs/      Operational notes
#
# NOTE: `backend/.gitignore` and `frontend/.gitignore` also apply, and git
# applies the deepest matching rule. The per-service files stay in place
# because the service directories are also usable standalone (e.g. copied
# into a Docker build context on their own).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
# Next.js
.next/
out/
.turbo/
.swc/

# The same artifacts inside the service directories. An unanchored pattern
# matches at any depth.
**/.next/
**/out/
**/dist/
**/build/

# Next.js standalone server is emitted inside .next/, but a manual build can
# drop it at the service root.
frontend/server.js

# General bundlers
dist/
build/
*.tsbuildinfo
tsconfig.tsbuildinfo

# ---------------------------------------------------------------------------
# Runtime state — volumes and generated data
# ---------------------------------------------------------------------------
# The backend writes logs and rendered images at runtime. All of it is
# disposable.
backend/logs/
backend/data/
backend/contents/
backend/output/
backend/assets/images/
backend/src/data/
backend/src/contents/

# Same names at any depth, in case the service is relocated.
**/logs/
**/data/
**/contents/

# Anything the app writes outside its service dir at runtime.
*.log
npm-debug.log*

# ---------------------------------------------------------------------------
# Environment / secrets
# ---------------------------------------------------------------------------
# `.env.example` files ARE tracked — they are the documented template for
# every variable the stack needs. Real `.env` files never are.
.env
.env.*
!.env.example
!*.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Secrets that must never reach the repo.
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
secrets.json
service-account*.json

# ---------------------------------------------------------------------------
# Tooling caches
# ---------------------------------------------------------------------------
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.prettiercache

# ---------------------------------------------------------------------------
# Editor / IDE
# ---------------------------------------------------------------------------
.idea/
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
*.swp
*.swo
*.swn
*.sublime-project
*.sublime-workspace
.history/
*.code-workspace
.project
.settings/
.classpath
.factorypath

# Agent / assistant workspace
.agent/
.cursor/
.cursorrules
.clinerules
.aider*
.windsurf/

# Puku CLI's local settings. `settings.local.json` holds machine-specific tool
# permissions and can carry live credentials pasted into a permission entry —
# it must never be committed.
.puku-cli/

# ---------------------------------------------------------------------------
# OS noise
# ---------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.directory

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
docker-compose.override.yml
docker-compose.local.yml
.dockerignore.local
.seaweedfs-src/

# ---------------------------------------------------------------------------
# Keep these tracked
# ---------------------------------------------------------------------------
!README.md
!instruction.md
!api.md
!project.md
!docs/
!docs/**
!backend/sql/
!backend/sql/**
!chroma/
!chroma/**
!seaweedfs/
!seaweedfs/**

# The env templates are the documented contract for every variable the stack
# needs. Both the root and the per-service `.env*` rules must let them back in.
!**/.env.example
!**/.env*.example

# `next-env.d.ts` is regenerated by `next build` / `next dev`, but it is also
# listed in tsconfig's `include`, so the file must exist for `tsc --noEmit` to
# type-check the app. Keep it tracked.
!frontend/next-env.d.ts
